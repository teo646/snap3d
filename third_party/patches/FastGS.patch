+    convention: `R` is camera-to-world, `x_cam = x_world @ R + T`) and `fx fy cx cy`.
+    `pixel_mask` ([H, W] bool, optional) restricts the computation to those pixels of A; the
+    rest come out 0. Every intermediate is per pixel and several are (N, 3) float32, so on
+    a 3 MP frame they are tens of MB each and a dozen are alive at once - the depth prior
+    only reads the conf inside the object's mask, a small fraction of the frame, so passing
+    that mask shrinks them by the same factor.
+
+    Returns [H, W] in [0, 1]: `exp(-error)` where the error is below `pixel_noise_th`, and
+    0 where it is not, or where the pixel falls outside B or has no depth to check.
+    """
+    H, W = depth_a.shape
+    dev = depth_a.device
+    if pixel_mask is None:
+        ys, xs = torch.meshgrid(torch.arange(H, device=dev), torch.arange(W, device=dev), indexing="ij")
+        pix = torch.stack([xs, ys], dim=-1).float().reshape(-1, 2)
+        d_a = depth_a.reshape(-1)
+    else:
+        ys, xs = torch.nonzero(pixel_mask, as_tuple=True)
+        pix = torch.stack([xs, ys], dim=-1).float()
+        d_a = depth_a[ys, xs]
+
+    def backproject(d, cam):
+        ray = torch.stack([(pix[:, 0] - cam["cx"]) / cam["fx"], (pix[:, 1] - cam["cy"]) / cam["fy"],
+                           torch.ones_like(pix[:, 0])], dim=-1)
+        x_cam = ray * d.reshape(-1, 1)
+        return (x_cam - cam["T"]) @ cam["R"].T
+
+    def to_cam(x_world, cam):
+        return x_world @ cam["R"] + cam["T"]
+
+    def project(x_cam, cam):
+        return torch.stack([x_cam[:, 0] * cam["fx"] / x_cam[:, 2] + cam["cx"],
+                            x_cam[:, 1] * cam["fy"] / x_cam[:, 2] + cam["cy"]], dim=-1)
+
+    cam_a = {k: (torch.as_tensor(v, dtype=torch.float32, device=dev)) for k, v in cam_a.items()}
+    cam_b = {k: (torch.as_tensor(v, dtype=torch.float32, device=dev)) for k, v in cam_b.items()}
+
+    x_in_b = to_cam(backproject(d_a, cam_a), cam_b)
+    uv_b = project(x_in_b, cam_b)
+    Hb, Wb = depth_b.shape
+    inside = (uv_b[:, 0] > 0) & (uv_b[:, 0] < Wb) & (uv_b[:, 1] > 0) & (uv_b[:, 1] < Hb) & (x_in_b[:, 2] > 0.1)
+    grid = torch.stack([uv_b[:, 0] / ((Wb - 1) / 2) - 1.0, uv_b[:, 1] / ((Hb - 1) / 2) - 1.0], dim=-1)
+    z_b = torch.nn.functional.grid_sample(
+        depth_b[None, None], grid.reshape(1, -1, 1, 2), mode="bilinear", padding_mode="border", align_corners=True
+    ).reshape(-1)
+    x_b_on_ray = x_in_b / x_in_b[:, 2:3] * z_b[:, None]
+    back = project(to_cam((x_b_on_ray - cam_b["T"]) @ cam_b["R"].T, cam_a), cam_a)
+    error = torch.norm(back - pix, dim=-1)
+    ok = inside & (z_b > 0) & (d_a > 0) & torch.isfinite(error) & (error < pixel_noise_th)
+    # where(), not `* ok`: a pixel whose error is NaN/inf would give NaN * 0 = NaN.
+    conf = torch.where(ok, torch.exp(-error), torch.zeros_like(error))
+    if pixel_mask is None:
+        return conf.reshape(H, W)
+    out = torch.zeros(H, W, device=dev, dtype=conf.dtype)
+    out[ys, xs] = conf
+    return out
+
+
+def depth_prior_loss(rendered_depth, prior_depth, prior_conf, mask, render_conf=None):
+    """Scale-and-shift invariant depth prior loss over `mask` only.
+
+    Metric3D is a monocular predictor: it sees one frame at a time, so its depth is not
+    scale-consistent between views and comparing it to the rendered depth directly would
+    fight the reconstruction's own scale. This solves a confidence-weighted least squares
+    for the per-view `omega * D_render + b ~ D_prior` that best aligns them, detaches
+    that solution, and only then takes the residual - so the gradient supervises the
+    *shape* of the depth and never its absolute scale or offset.
+
+    `mask` is the object silhouette intersected with wherever the render and the prior
+    are both valid. Restricting to it is the point: the prior is a statement about the
+    object, and on a capture where the object is a small part of the frame most of the
+    frame is background the prior has no business shaping.
+
+    `render_conf` ([1, H, W] in [0, 1], detached; None = off) is how far the render itself
+    can be trusted at each pixel. When given, the two uses of the weights part ways: the
+    alignment is fitted where the render is trustworthy (`prior_conf * render_conf`, plus a
+    small floor), because that is what the prior should be matched *to*; and the residual
+    is charged where it is not (`prior_conf * (1 - render_conf)`), because that is where
+    the prior has something to add. One weight for both would let the pixels the render
+    gets wrong pull the alignment, and then charge for that same error.
+
+    Returns a 0-d tensor; 0.0 when the mask has too few pixels to fit two parameters.
+    """
+    d_render = rendered_depth[mask]
+    d_prior = prior_depth[mask]
+    conf = prior_conf[mask]
+    if d_render.numel() < 2:
+        return torch.zeros((), device=rendered_depth.device)
+
+    if render_conf is None:
+        fit_weight, loss_weight = conf, conf
+    else:
+        r = render_conf[mask].clamp(0.0, 1.0).detach()
+        fit_weight = conf * (r + _RENDER_CONF_FIT_FLOOR)
+        loss_weight = conf * (1.0 - r)
+
+    sqrt_w = torch.sqrt(fit_weight)
+    A = torch.stack((sqrt_w * d_render, sqrt_w), dim=1)
+    B = sqrt_w * d_prior
+    # lstsq's own backward is both unnecessary and numerically unpleasant here - the fit
+    # is a per-view nuisance parameter, not something to differentiate through.
+    h = torch.linalg.lstsq(A, B).solution.detach()
+    aligned = h[0] * d_render + h[1]
+    return torch.mean(loss_weight * (aligned - d_prior) ** 2)
