+def quaternion_to_matrix(quaternions):
+    """Vendored from pytorch3d.transforms.quaternion_to_matrix (BSD-licensed) to avoid
+    depending on pytorch3d, which has no prebuilt wheel matching this project's
+    torch/CUDA/GPU-arch combination. quaternions: (..., 4) real-part-first (w, x, y, z)."""
+    r, i, j, k = torch.unbind(quaternions, -1)
+    two_s = 2.0 / (quaternions * quaternions).sum(-1)
+    o = torch.stack(
